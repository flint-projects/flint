module flint.java.io.interruptedioexception;

import flint.java.io : IOException;

@safe:

class InterruptedIOException : IOException
{
    /// Bytes transferred before the I/O operation was interrupted.
    int bytesTransferred;

    this(string message = null, string file = __FILE__, size_t line = __LINE__) pure nothrow
    {
        super(message, file, line);
    }
}
